<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="1dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="זיהוי צמחים"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/selectedPlantImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:contentDescription="התמונה שנבחרה לזיהוי" />

        <Button
            android:id="@+id/chooseImageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="בחירת תמונה מהגלריה"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/takePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="צילום תמונה חדשה"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/identificationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כאן תופיע תוצאת הזיהוי"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חזרה למסך הראשי"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>


